---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const date = new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<article class="group relative flex flex-col p-6 rounded-2xl bg-card-bg backdrop-blur-sm border border-card-border hover:border-primary/50 transition-colors duration-300">
  <time datetime={new Date(pubDate).toISOString()} class="text-xs text-primary mb-2 font-medium">{date}</time>
  <h3 class="text-xl font-bold mb-2">
    <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors focus:outline-none">
      <span class="absolute inset-0" aria-hidden="true"></span>
      {title}
    </a>
  </h3>
  <p class="text-sm text-foreground/80 mb-4">{description}</p>
  <TagList tags={tags} />
</article>
