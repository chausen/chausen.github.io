---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
];
---
<header id="site-header" class="fixed top-0 w-full z-50 transition-transform duration-300 bg-canvas/80 backdrop-blur-md border-b border-card-border">
  <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-bold text-xl tracking-tighter text-primary">chausen.dev</a>
    <nav class="hidden sm:flex gap-6">
      {links.map(link => (
        <a href={link.href} class="text-sm font-medium text-foreground/80 hover:text-primary transition-colors">{link.label}</a>
      ))}
    </nav>
    <div class="sm:hidden flex items-center gap-4">
      {links.map(link => (
        <a href={link.href} class="text-xs font-medium text-foreground/80 hover:text-primary transition-colors">{link.label}</a>
      ))}
    </div>
  </div>
</header>
<script src="../scripts/navReveal.ts"></script>
