---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const skillGroups = [
  {
    label: 'Languages',
    skills: ['Java', 'C#', 'Python', 'C++', 'C', 'JavaScript', 'TypeScript', 'Lua', 'SQL'],
  },
  {
    label: 'Platform / Web',
    skills: ['.NET', 'Spring', 'Blazor', 'Angular', 'Node.js', 'gRPC', 'REST services', 'AWS', 'Aurora RDS', 'Docker'],
  },
  {
    label: 'Systems / Quality',
    skills: ['Distributed systems', 'TCP/UDP services', 'Message buses', 'CI/CD', 'Terraform', 'Jenkins', 'Bamboo', 'SonarQube', 'BDD', 'Cucumber', 'Citrus', 'Karate'],
  },
];

const experience = [
  {
    role: 'Senior Software Engineer',
    company: 'Sierra Nevada Corporation',
    dates: 'March 2026 - Present',
    summary: 'Self-directed mission software leadership across services, tools, tactical UI, integration, and test strategy.',
    highlights: [
      'Serve as deputy lead for a 9-engineer team building Java and C# mission software, translating ambiguous operator, customer, and partner needs into implementation plans and technical decisions.',
      'Guide architecture and implementation across service, simulator, tactical UI, deployment, and automated test workstreams used by engineers and integration teams.',
      'Coordinate with customers, systems engineers, government development teams, and partner contractors on interface design, status, test planning, resource needs, data captures, and integration defects.',
      'Mentor engineers through design feedback, implementation guidance, code reviews, and test strategy improvements across distributed services and simulator work.',
    ],
  },
  {
    role: 'Software Engineer III',
    company: 'Sierra Nevada Corporation',
    dates: 'March 2023 - March 2026',
    summary: 'Backend services, C# tactical map plugin work, distributed testing, simulators, CI/CD, and deployment tooling.',
    highlights: [
      'Built Java OMS adapters, TCP/UDP integrations, gRPC service work, and ActiveMQ-based workflows enabling interoperability across aircraft mission systems.',
      'Designed and led automated BDD and data-driven black-box tests for distributed services, improving confidence in complex service interactions and hardware-facing integrations.',
      'Reduced test-event deployment setup from 1-2 days to 4 hours by creating offline browser checklists, deployment scripts, and installers; enabled prep and regression testing in 1 week instead of 2.',
      'Led teams at software integration lab events with live hardware, diagnosing issues, collecting data, validating fixes, and updating troubleshooting flows based on observed failures.',
      'Set up Bamboo build pipelines and SonarQube projects, added code coverage reporting, enhanced pipeline scripts, and improved code testability.',
    ],
  },
  {
    role: 'Software Engineer',
    company: 'Greenway Health',
    dates: 'August 2017 - February 2023',
    summary: 'C#/.NET services, full-stack healthcare workflows, cloud modernization, auth systems, and production support.',
    highlights: [
      'Designed services to populate cloud authorization systems with transformed on-prem security data for FHIR compliance, using a cache 500% faster than prior logic.',
      'Refactored a .NET 6 service to use Aurora RDS instead of DynamoDB for richer validation rules; updated Terraform and Jenkins DSL pipelines.',
      'Built Angular/TypeScript application features and contributed to C#, .NET, Progress ABL, and service integrations across a large legacy EHR platform.',
      'Built feature flag infrastructure exposing a unified LaunchDarkly-backed interface across WPF, Windows services, and ABL/C# integration points.',
      'Led production development work as the most senior team member, resolving high-priority defects and delivering Cures Act data push and telehealth integrations.',
    ],
  },
  {
    role: 'Software Engineer',
    company: 'The Home Depot',
    dates: 'June 2017 - August 2017',
    summary: 'Supply chain internal applications.',
    highlights: [
      'Selected for a competitive rotational program for top interns; contributed to Java and Angular applications and built a Node.js microservice.',
    ],
  },
];

const education = [
  {
    school: 'Georgia Institute of Technology',
    location: 'Atlanta, GA / Online',
    degree: 'M.S. in Computer Science, OMSCS program',
    dates: 'Starting Fall 2026',
  },
  {
    school: 'University of Florida',
    location: 'Gainesville, FL',
    degree: 'B.S. in Computer Science',
    dates: 'January 2013 - June 2017',
  },
];

const projects = [
  'CS50\'s Introduction to Game Development: completed project-based 2D games while studying gameplay architecture, state machines, collision, procedural generation, AI, and implementation patterns.',
  'HydroPatrol: built a C++/Python IoT control system with PID nutrient dosing, web monitoring, MQTT messaging, Node, MongoDB, Arduino, ESP32, and Raspberry Pi integration.',
  'Vista Hackathon / RAID-A-Thon: built a no-code FHIR app builder prototype with AWS DynamoDB and earned production defect-resolution awards using TDD.',
];
---
<BaseLayout title="Resume | chausen.dev" description="Resume for Clay Hausen, a senior software engineer focused on mission software, distributed services, testing, and integration tooling.">
  <SectionHeading title="Resume" />
  <article class="max-w-3xl mx-auto p-6 sm:p-8 rounded-lg bg-card-bg border border-card-border backdrop-blur-sm">
    <header class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-10">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-foreground">Clay T. Hausen</h2>
        <p class="mt-1 text-primary font-medium">Senior Software Engineer</p>
        <p class="mt-3 max-w-2xl text-sm sm:text-base text-foreground/76 leading-relaxed">
          Denver-based engineer focused on mission software, distributed services, tactical tooling, automated testing, and practical developer workflows.
        </p>
      </div>
      <div class="text-sm text-foreground/68 sm:text-right leading-relaxed">
        <a href="mailto:clayhausen@gmail.com" class="text-primary hover:text-primary-hover transition-colors">clayhausen@gmail.com</a>
        <div>Denver, CO</div>
      </div>
    </header>

    <div class="space-y-10">
      <section>
        <h3 class="text-xl font-bold border-b border-card-border pb-2 mb-5">Experience</h3>
        <div class="space-y-6">
          {experience.map(job => (
            <section class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <div>
                  <h4 class="font-bold text-foreground">{job.role}</h4>
                  <p class="text-sm text-primary">{job.company}</p>
                </div>
                <span class="text-sm text-foreground/60">{job.dates}</span>
              </div>
              <p class="text-sm text-foreground/72 leading-relaxed">{job.summary}</p>
              <ul class="list-disc pl-5 text-sm text-foreground/80 space-y-1.5 leading-relaxed">
                {job.highlights.map(highlight => <li>{highlight}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-xl font-bold border-b border-card-border pb-2 mb-5">Skills</h3>
        <div class="space-y-4">
          {skillGroups.map(group => (
            <div>
              <h4 class="mb-2 text-sm font-semibold text-foreground/88">{group.label}</h4>
              <div class="flex flex-wrap gap-2">
                {group.skills.map(skill => (
                  <span class="px-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-md text-sm">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-xl font-bold border-b border-card-border pb-2 mb-5">Education</h3>
        <div class="space-y-4">
          {education.map(item => (
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <div>
                <h4 class="font-bold text-foreground">{item.school}</h4>
                <p class="text-sm text-foreground/76">{item.degree}</p>
                <p class="text-sm text-foreground/60">{item.location}</p>
              </div>
              <span class="text-sm text-foreground/60">{item.dates}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-xl font-bold border-b border-card-border pb-2 mb-5">Projects</h3>
        <ul class="list-disc pl-5 text-sm text-foreground/80 space-y-1.5 leading-relaxed">
          {projects.map(project => <li>{project}</li>)}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
