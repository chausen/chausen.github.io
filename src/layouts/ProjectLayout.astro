---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} | chausen.dev`} description={frontmatter.description}>
  <article class="content-prose prose prose-invert mx-auto max-w-3xl prose-p:text-foreground/84 prose-headings:text-foreground prose-strong:text-foreground prose-a:text-primary hover:prose-a:text-primary-hover prose-img:rounded-xl prose-hr:border-card-border prose-quotes:text-foreground/90 prose-code:text-foreground prose-pre:text-foreground prose-li:text-foreground/84 prose-th:text-foreground prose-td:text-foreground/80">
    <header class="mb-10 text-center not-prose">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-6">{frontmatter.title}</h1>
      <div class="flex justify-center mb-6">
        <TagList tags={frontmatter.tags} />
      </div>
      {(frontmatter.repoUrl || frontmatter.demoUrl) && (
        <div class="flex gap-4 justify-center">
          {frontmatter.repoUrl && <a href={frontmatter.repoUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-card-bg border border-card-border rounded-lg hover:border-primary transition-colors no-underline text-sm font-medium">GitHub</a>}
          {frontmatter.demoUrl && <a href={frontmatter.demoUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover transition-colors no-underline text-sm font-medium">Live Demo</a>}
        </div>
      )}
    </header>
    <div class="mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
