---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundCanvas from '../components/BackgroundCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = "chausen.dev", description = "Clay's portfolio and blog" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col pt-16 selection:bg-primary/30 selection:text-foreground">
    <BackgroundCanvas />
    <Header />
    <main class="flex-grow w-full max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
